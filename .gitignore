crates/testing/leek-test-corpus/data/upstream_cases.json
crates/testing/leek-test-corpus/data/baseline.json

**/*.rs.bk
.DS_Store

# Logs and Python tooling caches
*.log
__pycache__/
*.pyc

# Build output (leek `build/`, Java `build/` class dirs, …) at any depth
build/

# Upstream LeekScript compiler output. `JavaCompiler.IA_PATH` is hard-coded to
# "ai", so any JVM run drops AI_<id>.java/.class/.lines/.sig into ./ai relative
# to its working directory. `cargo xtask check-artifacts` keeps this honest.
/ai/

# Node / VS Code extension build artifacts
node_modules/
editors/vscode/dist/
*.vsix

# Local Claude / agent session data
/.claude/
